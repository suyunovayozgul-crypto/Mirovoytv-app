{
  "expo": {
    "name": "Mirovoy TV",
    "slug": "mirovoy-tv-app",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#02162f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "uz.mirovoytv.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02162f"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "plugins": [
      "./plugins/withAndroidTV.js",
      "./plugins/withAbiSplit.js",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "owner": "tirkashbeks-team",
    "extra": {
      "eas": { "projectId": "7b79e564-5028-47f1-9047-aae06c62cdeb" }
    }
  }
}
